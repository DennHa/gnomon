{
  "name": "gnomon",
  "productName": "Gnomon",
  "version": "0.1.10",
  "private": true,
  "description": "Gnomon: a personal desktop time tracker with workday clock in/out, project timers and reports.",
  "homepage": "https://github.com/DennHa/gnomon",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n vite,electron \"node node_modules/vite/bin/vite.js\" \"node node_modules/wait-on/bin/wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 node node_modules/electron/cli.js .\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "build:demo": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --config vite.demo.config.ts && node scripts/build-demo-phone.mjs",
    "start": "npm run build && node node_modules/electron/cli.js .",
    "dist": "npm run build && node node_modules/electron-builder/cli.js --mac",
    "icon": "node node_modules/electron/cli.js scripts/make-icon.cjs",
    "test": "node_modules/.bin/esbuild tests/logic.test.ts --bundle --platform=node --format=esm --outfile=dist-test/logic.test.mjs --log-level=warning && node dist-test/logic.test.mjs",
    "release:manifest": "node scripts/release-manifest.cjs",
    "credits": "node scripts/credits.cjs"
  },
  "build": {
    "appId": "app.gnomon.timetracker",
    "productName": "Gnomon",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "wait-on": "^8.0.1"
  },
  "author": "Gnomon contributors"
}
